+/* debug tools are locked behind a password; only its SHA-256 hash is stored, and it stays unlocked until the game is closed */
+const DBG_HASH='be506e41de6c59c80151c6a59aaf85bda4760886f84ed767b4778efcfe9a705d';
+let dbgOpen=false;
+function sha256(str){const rr=(v,n)=>(v>>>n)|(v<<(32-n)),K=[],H=[];
+  for(let p=2,c=0;c<64;p++){let pr=true;for(let d=2;d*d<=p;d++)if(p%d===0){pr=false;break;}
+    if(pr){if(c<8)H[c]=(Math.pow(p,1/2)*4294967296)|0;K[c++]=(Math.pow(p,1/3)*4294967296)|0;}}
+  const b=[...new TextEncoder().encode(str)],L=b.length*8;b.push(0x80);while(b.length%64!==56)b.push(0);
+  for(let i=7;i>=0;i--)b.push(Math.floor(L/Math.pow(2,8*i))&255);
+  const h=H.slice();
+  for(let i=0;i<b.length;i+=64){const w=[];for(let j=0;j<16;j++)w[j]=(b[i+4*j]<<24)|(b[i+4*j+1]<<16)|(b[i+4*j+2]<<8)|b[i+4*j+3];
+    for(let j=16;j<64;j++){const s0=rr(w[j-15],7)^rr(w[j-15],18)^(w[j-15]>>>3),s1=rr(w[j-2],17)^rr(w[j-2],19)^(w[j-2]>>>10);w[j]=(w[j-16]+s0+w[j-7]+s1)|0;}
+    let[a,bb,c,d,e,f,g,k]=h;
+    for(let j=0;j<64;j++){const t1=(k+(rr(e,6)^rr(e,11)^rr(e,25))+((e&f)^(~e&g))+K[j]+w[j])|0,t2=((rr(a,2)^rr(a,13)^rr(a,22))+((a&bb)^(a&c)^(bb&c)))|0;
+      k=g;g=f;f=e;e=(d+t1)|0;d=c;c=bb;bb=a;a=(t1+t2)|0;}
+    [a,bb,c,d,e,f,g,k].forEach((v,n)=>{h[n]=(h[n]+v)|0;});}
+  return h.map(x=>(x>>>0).toString(16).padStart(8,'0')).join('');}
